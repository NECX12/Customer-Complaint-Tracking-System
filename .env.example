# =====================================================
# Mikano Complaint Tracker — Environment Variables
# =====================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =====================================================

# --- Database (Supabase PostgreSQL) ---
# Supabase format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Local Docker:    postgresql://postgres:postgres@localhost:5432/complaint_tracker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/complaint_tracker

# --- JWT Authentication ---
SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Email (SMTP) ---
# Leave SMTP_HOST blank to disable email (emails are logged to console instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Application ---
DEBUG=true
