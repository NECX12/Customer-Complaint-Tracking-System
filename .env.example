# =====================================================
# Complaint Tracker — Environment Variables
# =====================================================


# --- GEMINI AI PROVIDER USAGE ----
GEMINI_API_KEY=use-your-google-api-key
AI_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Database (Supabase PostgreSQL) ---
# Supabase format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Environment: development | staging | production
ENVIRONMENT=development

# --- JWT Authentication ---
SECRET_KEY=generate-your-secret-key-and-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480


# --- Email (SMTP) ---
# Leave SMTP_HOST blank to disable email (emails are logged to console instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM= 

API_V1_PREFIX=/api/v1

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Application ---
DEBUG=true

REDIS_URL=localhost-redis-url

